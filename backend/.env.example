# MySQL connection string, e.g. mysql://user:password@localhost:3306/blood
DATABASE_URL="mysql://root:password@localhost:3306/blood"

# Secret used to sign backend session JWTs and short-lived registration tokens
JWT_SECRET="change-me-to-a-long-random-string"

# Base URL this server is reachable at — used to build profile-photo URLs.
# When testing from a phone/emulator, set this to your machine's LAN IP, e.g. http://192.168.1.20:4000
PUBLIC_BASE_URL="http://localhost:4000"

PORT=4000
